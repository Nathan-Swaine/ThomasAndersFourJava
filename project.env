NEO4J_AUTH=neo4j/neo4jpassword
NEO4J_URI=bolt://neo4j:7687
NEO4J_USER=neo4j
NEO4J_PASSWORD=neo4jpassword
NEO4J_server_memory_pagecache_size=4G
NEO4J_server_memory_heap_initial__size=1500m
NEO4J_server_memory_heap_max__size=1500m
NEO4J_db_checkpoint_iops_limit=-1
NEO4J_db_tx__log_rotation_retention__policy=1 files

IMPORT_DIR=/data
CSV_PATH=
IMPORT_SOURCE=
RESET_GRAPH=false

GAFFER_BATCH_SIZE=5000
GAFFER_CONVERT_LIMIT=2905079
